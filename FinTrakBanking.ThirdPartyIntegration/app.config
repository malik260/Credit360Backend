<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <system.serviceModel>
        <bindings>
            <basicHttpBinding>
                <binding name="XDSNigeriaWebServiceSoap" allowCookies="true"
                    maxBufferPoolSize="20000000" maxBufferSize="20000000" maxReceivedMessageSize="20000000">
                    <readerQuotas maxDepth="32" maxStringContentLength="200000000"
                        maxArrayLength="200000000" />
                    <security mode="Transport" />
                </binding>
                <binding name="XDSNigeriaWebServiceSoap1" />
                <binding name="LiveRequestInvokerSoap">
                    <security mode="Transport" />
                </binding>
                <binding name="LiveRequestInvokerSoap1" />
            </basicHttpBinding>
            <customBinding>
                <binding name="LiveRequestInvokerSoap12">
                    <textMessageEncoding messageVersion="Soap12" />
                    <httpsTransport />
                </binding>
            </customBinding>
        </bindings>
        <client>
            <endpoint address="https://online.xdscreditbureau.com/XdsNigeriaWebservice/XDSNigeriaWebService.asmx"
                binding="basicHttpBinding" bindingConfiguration="XDSNigeriaWebServiceSoap"
                contract="XDSWebService.XDSNigeriaWebServiceSoap" name="XDSNigeriaWebServiceSoap" />
            <endpoint address="https://webserver.creditreferencenigeria.net/crcweb/liverequestinvoker.asmx"
                binding="basicHttpBinding" bindingConfiguration="LiveRequestInvokerSoap"
                contract="CRCWebService.LiveRequestInvokerSoap" name="LiveRequestInvokerSoap" />
            <endpoint address="https://webserver.creditreferencenigeria.net/crcweb/liverequestinvoker.asmx"
                binding="customBinding" bindingConfiguration="LiveRequestInvokerSoap12"
                contract="CRCWebService.LiveRequestInvokerSoap" name="LiveRequestInvokerSoap12" />
        </client>
    </system.serviceModel>
</configuration>