    <add name="FinTrakBankingDocumentsContext" connectionString="DATA SOURCE=192.168.10.8:1521/pdb01;PASSWORD=Password10$;PERSIST SECURITY INFO=True;USER ID= FINTRAKBANKINGDOCUMENTS" providerName="Oracle.ManagedDataAccess.Client" />-->

    <add name="FinTrakBankingContext" connectionString="DATA SOURCE=FTTRAK360;PASSWORD=sqluser10$;PERSIST SECURITY INFO=True;USER ID=FINTRAKBANKING" providerName="Oracle.ManagedDataAccess.Client"/>
    <add name="FinTrakBankingDocumentsContext" connectionString="DATA SOURCE=FTTRAK360;PASSWORD=sqluser10$;PERSIST SECURITY INFO=True;USER ID=FINTRAKBANKINGDOCUMENTS" providerName="Oracle.ManagedDataAccess.Client"/>
    <add name="FinTrakBankingStagingContext" connectionString="DATA SOURCE=172.16.248.45:1521/fintrakdb;PASSWORD=password2;PERSIST SECURITY INFO=True;USER ID=FINTRAKSTAGING" providerName="Oracle.ManagedDataAccess.Client"/>

    <!--<add name="FinTrakBankingDocumentsContext" connectionString="DATA SOURCE=172.16.248.45:1521/fintrakdb;PASSWORD=sqluser10$;PERSIST SECURITY INFO=True;USER ID=FINTRAKBANKINGDOCUMENTS" providerName="Oracle.ManagedDataAccess.Client"/>
    <add name="FinTrakBankingContext" connectionString="DATA SOURCE=172.16.248.45:1521/fintrakdb;PASSWORD=sqluser10$;PERSIST SECURITY INFO=True;USER ID=FINTRAKBANKING" providerName="Oracle.ManagedDataAccess.Client" />
