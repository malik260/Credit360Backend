<configuration>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.6.1" />
    <httpRuntime targetFramework="4.6.1" />
  </system.web>
  <connectionStrings>

    <!--<add name="FinTrakBankingContext" connectionString="DATA SOURCE=192.168.10.95:1521/pdb01;PASSWORD=Password10$;PERSIST SECURITY INFO=True;USER ID=FINTRAKBANKING" providerName="Oracle.ManagedDataAccess.Client" />
